{
  "name": "@kamod-ch/brand",
  "version": "0.4.0",
  "description": "Shared Kamod product logos for docs sites and GitHub READMEs.",
  "type": "module",
  "license": "MIT",
  "author": "Klaus Zahiragic",
  "repository": {
    "type": "git",
    "url": "https://github.com/kamod-ch/kamod-brand"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./logo.css": "./styles/logo.css",
    "./assets/*": "./assets/*"
  },
  "files": [
    "dist",
    "README.md",
    "styles",
    "assets",
    "scripts",
    "snippets"
  ],
  "sideEffects": [
    "./styles/logo.css"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "brand:readme": "node ./scripts/generate-readme-logos.mjs --product Brand --output .github/assets",
    "generate-readme-logos": "node ./scripts/generate-readme-logos.mjs",
    "sync-docs-assets": "node ./scripts/sync-docs-assets.mjs",
    "clean": "rm -rf dist",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release:check": "pnpm build && pnpm typecheck",
    "release:publish": "pnpm publish --access public --no-git-checks",
    "release": "node ./scripts/release.mjs patch",
    "release:minor": "node ./scripts/release.mjs minor",
    "release:major": "node ./scripts/release.mjs major",
    "release:dry": "node ./scripts/release.mjs patch --dry"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "bin": {
    "kamod-brand-readme": "./scripts/generate-readme-logos.mjs",
    "kamod-brand-sync-docs": "./scripts/sync-docs-assets.mjs"
  },
  "peerDependencies": {
    "preact": ">=11"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "preact": "^11.2.0",
    "tsup": "^9.0.0",
    "typescript": "~7.0.2"
  },
  "keywords": [
    "kamod",
    "brand",
    "logo",
    "preact"
  ]
}
